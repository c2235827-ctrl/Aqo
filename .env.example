# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for canonical URLs, sitemap generation, and self-referential links.
APP_URL="MY_APP_URL"

# VITE_SITE_URL: Optional public canonical origin (e.g. https://aqoriel.example)
VITE_SITE_URL=""

# Official Contact Mailbox Configuration (leave empty until official mailbox is ready)
CONTACT_TO_EMAIL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Future Integrations (Server-side only — never prefix with VITE_)
# TELEGRAM_BOT_TOKEN=""
# HERMES_AGENT_API_URL=""
# HERMES_AGENT_API_KEY=""
